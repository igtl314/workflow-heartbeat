{
  "extends": ["config:recommended", "schedule:nonOfficeHours"],
  "enabledManagers": ["npm"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "npm": {
    "commitMessagePrefix": "renovate: ",
    "major": {
      "automerge": false,
      "draftPR": true,
      "labels": ["Major"]
    },
    "patch": {
      "automerge": true,
      "labels": ["Patch"]
    },
    "minor": {
      "automerge": true,
      "labels": ["Minor"]
    },
    "pin": {
      "automerge": true,
      "labels": ["Pin"]
    },
    "lockFileMaintenance": {
      "automerge": true,
      "draftPR": true,
      "labels": ["LockFile"]
    },
    "vulnerabilityAlerts": {
      "automerge": true,
      "labels": ["Security"]
    }
  },
  "updateNotScheduled": false,
  "prConcurrentLimit": 15,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "7 days",
  "timezone": "Europe/Stockholm",
  "rebaseWhen": "conflicted",
  "stopUpdatingLabel": "Pause Renovate"
}
