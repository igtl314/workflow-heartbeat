{
  "name": "workflow-heartbeat",
  "displayName": "Workflow Heartbeat",
  "description": "Monitor GitHub Actions workflows and get notified when they fail",
  "version": "1.1.0",
  "publisher": "igtl314",
  "icon": "resources/icon-marketplace.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/igtl314/workflow-heartbeat"
  },
  "vsce": {
    "dependencies": false
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "github",
    "actions",
    "workflow",
    "ci",
    "cd",
    "monitoring",
    "notifications"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Workflow Heartbeat",
      "properties": {
        "woa.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show workflow status in the status bar"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workflow-alerter",
          "title": "Workflow Heartbeat",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "workflow-alerter": [
        {
          "id": "woa.configView",
          "name": "Configuration",
          "type": "tree"
        },
        {
          "id": "woa.runsView",
          "name": "Recent Runs",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "woa.selectWorkflow",
        "title": "Workflow Heartbeat: Select Branch and Workflow to Monitor",
        "icon": "$(gear)"
      },
      {
        "command": "woa.selectBranch",
        "title": "Workflow Heartbeat: Select Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "woa.selectWorkflowOnly",
        "title": "Workflow Heartbeat: Select Workflow",
        "icon": "$(workflow)"
      },
      {
        "command": "woa.stopMonitoring",
        "title": "Workflow Heartbeat: Stop Monitoring",
        "icon": "$(debug-stop)"
      },
      {
        "command": "woa.refreshStatus",
        "title": "Workflow Heartbeat: Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "woa.openRun",
        "title": "Open Run on GitHub",
        "icon": "$(link-external)"
      },
      {
        "command": "woa.selectNotifyUsers",
        "title": "Workflow Heartbeat: Select Users to Notify For",
        "icon": "$(person)"
      },
      {
        "command": "woa.selectFilterUsers",
        "title": "Workflow Heartbeat: Filter Out Users from Runs",
        "icon": "$(filter)"
      },
      {
        "command": "woa.toggleStatusBar",
        "title": "Workflow Heartbeat: Toggle Status Bar",
        "icon": "$(layout-statusbar)"
      },
      {
        "command": "woa.toggleHidePassedRuns",
        "title": "Workflow Heartbeat: Hide Passed Runs",
        "icon": "$(filter)"
      },
      {
        "command": "woa.signIn",
        "title": "Workflow Heartbeat: Sign In to GitHub",
        "icon": "$(sign-in)"
      },
      {
        "command": "woa.logout",
        "title": "Workflow Heartbeat: Sign Out of GitHub",
        "icon": "$(sign-out)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "woa.toggleHidePassedRuns",
          "when": "view == woa.runsView && !woa.hidePassedRuns",
          "group": "navigation"
        },
        {
          "command": "woa.toggleHidePassedRuns",
          "when": "view == woa.runsView && woa.hidePassedRuns",
          "group": "navigation"
        },
        {
          "command": "woa.refreshStatus",
          "when": "view == woa.runsView",
          "group": "navigation"
        }
      ]
    },
    "colors": [
      {
        "id": "woa.statusBarSuccessBackground",
        "description": "Status bar background color when workflow passes",
        "defaults": {
          "dark": "#2e7d32",
          "light": "#4caf50",
          "highContrast": "#2e7d32"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "octokit": "^4.0.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
